<resources>
    <string name="android_field_bind_address_purpose">绑定地址由主页的局域网访问开关决定。</string>
    <string name="android_field_bind_address_scenarios">需要局域网设备连接本机代理端口时，前往主页基础设置。</string>
    <string name="android_field_bind_address_cautions">关闭时仅监听本机。这个字段由主页管理，不在本地配置修改。</string>
    <string name="android_field_bind_address_title">bind-address</string>
    <string name="android_field_find_process_purpose">控制内核何时查询连接对应的进程信息。</string>
    <string name="android_field_find_process_scenarios">默认按需匹配；仅在规则需要进程信息时查询。</string>
    <string name="android_field_find_process_cautions">Android 会限制部分进程信息。始终查询不代表能绕过系统限制。</string>
    <string name="android_field_find_process_title">find-process-mode</string>
    <string name="android_field_http_port_purpose">HTTP 代理监听端口，由主页监听类型和端口共同决定。</string>
    <string name="android_field_http_port_scenarios">需要手动连接 HTTP 代理的客户端时使用。</string>
    <string name="android_field_http_port_cautions">Android VPN 通道不依赖手动设置系统代理。未选中 HTTP 时删除该端口字段。</string>
    <string name="android_field_http_port_title">port</string>
    <string name="android_field_socks_port_purpose">SOCKS 代理监听端口，由主页监听类型和端口共同决定。</string>
    <string name="android_field_socks_port_scenarios">需要手动连接 SOCKS 代理的客户端时使用。</string>
    <string name="android_field_socks_port_cautions">未选中 SOCKS 时删除该字段，混合监听使用 mixed-port。</string>
    <string name="android_field_socks_port_title">socks-port</string>
    <string name="android_field_proxy_udp_purpose">对支持此字段的节点统一设置 UDP 转发开关。</string>
    <string name="android_field_proxy_udp_scenarios">统一允许或关闭节点的 UDP 支持时使用。</string>
    <string name="android_field_proxy_udp_cautions">只修改支持该字段的协议，不会为不支持 UDP 的服务器增加能力。</string>
    <string name="android_field_proxy_udp_title">proxies.*.udp</string>
    <string name="android_field_proxy_tfo_purpose">对支持此字段的节点统一设置 TCP Fast Open。</string>
    <string name="android_field_proxy_tfo_scenarios">服务器与网络都支持 TCP Fast Open 时使用。</string>
    <string name="android_field_proxy_tfo_cautions">系统或服务器不支持时可能无效；关闭字段会保留订阅原值。</string>
    <string name="android_field_proxy_tfo_title">proxies.*.tfo</string>
    <string name="android_field_proxy_mptcp_purpose">对支持此字段的节点统一设置多路径 TCP。</string>
    <string name="android_field_proxy_mptcp_scenarios">网络和服务器支持多路径 TCP 时使用。</string>
    <string name="android_field_proxy_mptcp_cautions">这个设置不能代替系统内核与服务端对 MPTCP 的支持。</string>
    <string name="android_field_proxy_mptcp_title">proxies.*.mptcp</string>
    <string name="android_field_proxy_fingerprint_purpose">统一兼容节点的 TLS 客户端指纹。</string>
    <string name="android_field_proxy_fingerprint_scenarios">连接要求特定 TLS 指纹的服务端时使用。</string>
    <string name="android_field_proxy_fingerprint_cautions">只处理内核支持该字段的协议，不能保证流量无法被识别。</string>
    <string name="android_field_proxy_fingerprint_title">proxies.*.client-fingerprint</string>
    <string name="android_field_proxy_dialer_purpose">统一设置兼容节点连接服务器时使用的前置代理。</string>
    <string name="android_field_proxy_dialer_scenarios">需要通过现有节点或选择器连接下一跳时使用。</string>
    <string name="android_field_proxy_dialer_cautions">引用目标必须存在，不能引用自己或形成循环。候选保存前会检查引用。</string>
    <string name="android_field_proxy_dialer_title">proxies.*.dialer-proxy</string>
    <string name="android_field_proxy_ip_version_purpose">统一兼容节点连接服务端时的 IPv4/IPv6 优先方式。</string>
    <string name="android_field_proxy_ip_version_scenarios">网络的某个 IP 协议栈不可用或需要优先使用时设置。</string>
    <string name="android_field_proxy_ip_version_cautions">只影响连接服务端，不等于控制应用 DNS 返回；全局 IPv6 仍受主页设置约束。</string>
    <string name="android_field_proxy_ip_version_title">proxies.*.ip-version</string>
</resources>
